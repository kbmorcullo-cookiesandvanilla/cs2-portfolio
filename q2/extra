snum = "7"
ticks = 0
while True:
  guess = input("Guess the secret number: ")
  guess != snum
  tick = ticks + 1
  print("Attempts:", tick)
  ticks = tick
  
  if guess == snum:
    print("Done")
    break
  else:
    continue

